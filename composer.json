{
    "name": "manggala/laravel-datatable",
    "description": "Production-ready, keyboard-navigable, server-driven Data Table package for Laravel and Inertia.js applications.",
    "keywords": [
        "manggala",
        "laravel",
        "datatable",
        "data-table",
        "inertia",
        "react",
        "table-builder",
        "grid"
    ],
    "homepage": "https://github.com/IlhamHattaManggala/laravel-datatable",
    "license": "MIT",
    "authors": [
        {
            "name": "Ilham Hatta Manggala",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^1.0 || ^2.0 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Manggala\\DataTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manggala\\DataTable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Manggala\\DataTable\\DataTableServiceProvider"
            ],
            "aliases": {
                "DataTable": "Manggala\\DataTable\\Facades\\DataTable"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
